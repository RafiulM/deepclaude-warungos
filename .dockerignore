warungos.db-shm
warungos.db-wal

# Editor / OS cruft
.DS_Store
*.pem
npm-debug.log*
.vscode
.idea

# Docs / misc not needed at runtime
README.md
prd.md
Dockerfile
.dockerignore
docker-compose.yml
