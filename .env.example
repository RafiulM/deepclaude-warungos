# Copy to .env and fill in. Server-side vars are read at runtime.
# Pass to the container with: docker run --env-file .env ...

# Path to the SQLite database file (the app strips the file: prefix).
# In Docker this defaults to the mounted volume at /app/data/warungos.db.
DATABASE_URL=file:./warungos.db

# REQUIRED in production. better-auth throws on startup if this is unset.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Public base URL of the app (used by better-auth for callbacks/cookies).
BETTER_AUTH_URL=http://localhost:3000

# Login password for the app.
APP_PASSWORD=warung123

# Public app URL. NEXT_PUBLIC_* vars are inlined at BUILD time, so for Docker
# pass this as a build arg: docker build --build-arg NEXT_PUBLIC_APP_URL=...
# NEXT_PUBLIC_APP_URL=http://localhost:3000
